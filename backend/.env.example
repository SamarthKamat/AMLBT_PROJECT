# Copy this file to .env (backend/.env) and fill in your own values. Never commit or share .env.

# --- Planner -------------------------------------------------------------------------------------------
# auto (default): Gemini when GEMINI_API_KEY/GEMINI_MODEL are set; otherwise (or if Gemini fails) the local
#                 intent model plans the question. local: always the offline local planner. gemini: Gemini only.
UDI_PLANNER=auto

# Gemini (optional in auto/local mode, required in gemini mode): https://aistudio.google.com/apikey
GEMINI_API_KEY=
# The Gemini model your key can use. No built-in default; the status chip in the UI lists available models.
GEMINI_MODEL=gemini-2.5-flash
GEMINI_TIMEOUT_SECONDS=60       # per Gemini request
GEMINI_SAMPLE_ROWS=3            # sample rows sent to Gemini for planning (0 = schema and statistics only)

# --- Server --------------------------------------------------------------------------------------------
FLASK_PORT=5000
UDI_MAX_UPLOAD_MB=50
UDI_SESSION_TTL_SECONDS=21600   # sessions (and their stored datasets) expire after 6 hours of inactivity
UDI_PERSIST_SESSIONS=true       # keep datasets + conversations in UDI_DATA_DIR so a restart does not lose them
# UDI_DATA_DIR=./data

# --- Security ------------------------------------------------------------------------------------------
UDI_AUTH=off                    # on = users must register / sign in; sessions are private to their owner
UDI_RATE_CHAT=40                # requests per minute per user
UDI_RATE_UPLOAD=15
UDI_RATE_REPORT=8
UDI_CORS_ORIGINS=*
