# Copy this file to .env (backend/.env) and fill in your own values. Never commit or share .env.

# Required: your Gemini API key (https://aistudio.google.com/apikey)
GEMINI_API_KEY=your_gemini_api_key_here

# Required: the Gemini model your key can use. There is no built-in default, so a retired model name can never be used silently.
# The status chip in the UI (click it) verifies the model and lists the models your key can call if this one is unavailable.
GEMINI_MODEL=gemini-3.6-flash

# Optional
GEMINI_TIMEOUT_SECONDS=60       # per Gemini request
GEMINI_SAMPLE_ROWS=3            # sample rows sent to Gemini for planning (0 = send no row values, schema and statistics only)
FLASK_PORT=5000
UDI_MAX_UPLOAD_MB=50
